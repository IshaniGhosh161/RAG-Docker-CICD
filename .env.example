# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/chatbot?retryWrites=true&w=majority
MONGO_TELEMETRY_DATABASE=chatbot

# Ollama
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_MODEL=gpt-oss:20b-cloud

# Tavily web search
TAVILY_API_KEY=your_tavily_api_key_here

# RAG settings
RETRIEVAL_K=10
RERANK_TOP_N=5
ENABLE_RERANKER=True
FAST_MODE=False

# Hugging Face embeddings
HF_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
HF_EMBEDDING_DEVICE=cpu
HF_EMBEDDING_BATCH_SIZE=8

# API and logging
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=INFO
LOG_FILE=api.log

# OpenTelemetry
OTEL_SERVICE_NAME=rag-chat-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces

# Docker Hub and Grafana options
DOCKERHUB_IMAGE=chatbot-rag
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASSWORD=

# Test configuration
API_BASE_URL=http://localhost:5000
